# Angel One API credentials
ANGELONE_API_KEY=your_api_key_here



# Redis Cloud (stores angelone_jwt_feed)
REDIS_HOST=your-redis-host.redislabs.com
REDIS_PORT=12203
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Storage paths (defaults shown)
# SQLITE_DIR=/home/ubuntu/sqlite/strategies/
# SNAPSHOT_DIR=/home/ubuntu/sqlite/strategies/

# Log level (DEBUG or INFO)
LOG_LEVEL=INFO

# Gmail SMTP weekly report
EMAIL_SENDER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENT=recipient@example.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465

# Optional report archive directory
# WEEKLY_REPORT_DIR=/home/ubuntu/sqlite/strategies/reports

# MongoDB Atlas Database Configuration (Shared with stocks, recommendations, commodities)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=stock_recommendations
MONGODB_COLLECTION_DERIVATIVE_STRATEGIES=derivative_strategies
MONGODB_COLLECTION_DERIVATIVE_MASTER=derivative_master
MONGODB_COLLECTION_DERIVATIVE_PREDICTIONS=derivative_predictions
NIFTY_LOT_SIZE=65
PEAK_ALERT_ENABLED=true
PEAK_ALERT_MIN_PROFIT_PCT=20.0
PEAK_ALERT_HYSTERESIS_PCT=5.0
PEAK_ALERT_HYSTERESIS_PTS=10.0
# Discord Exit Alerts Webhooks (Track-specific routing)
DISCORD_EXIT_5DAY=https://discord.com/api/webhooks/YOUR_5DAY_EXIT_WEBHOOK_URL
DISCORD_EXIT_3DAY=https://discord.com/api/webhooks/YOUR_3DAY_EXIT_WEBHOOK_URL
# Legacy fallback (used if track-specific variable is omitted)
DISCORD_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# Discord #watchdog channel (ops alerts, EOD digests, heartbeat) — distinct from DISCORD_URL
DISCORD_WATCHDOG=https://discord.com/api/webhooks/YOUR_NEW_WATCHDOG_URL


# ---------------------------------------------------------------------------
# Configurable Broker Routing per Strategy Cycle
# ---------------------------------------------------------------------------
# Supported brokers: upstox, angelone
# Default mapping:
TUESDAY_BROKER=upstox
THURSDAY_BROKER=upstox

# Fixed ITM1 strike grid for both tracks (CE one step below spot, PE one step above). NIFTY lists 50-pt strikes.
ITM1_STRIKE_STEP=50
# Any of the 4 combinations is supported:
# Tuesday=upstox, Thursday=angelone
# Tuesday=angelone, Thursday=upstox (swapped)
# Tuesday=upstox, Thursday=upstox (default: both on Upstox)
# Tuesday=angelone, Thursday=angelone (both on AngelOne)
UPSTOX_ACCESS_TOKEN=your_upstox_token_here
UPSTOX_BASE_URL=https://api.upstox.com
ANGELONE_BASE_URL=https://apiconnect.angelone.in
